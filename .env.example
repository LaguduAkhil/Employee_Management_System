# Application Settings
DEBUG=False
LOG_LEVEL=INFO

# Database Configuration
# PostgreSQL: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://emp_user:emp_password@localhost:5432/employee_db

# Security
# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-generate-new-one

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
